# Netlify headers. Paths here are Netlify-style patterns (no origin/URL prefix).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Vite fingerprints filenames inside /assets, so these are safe to pin for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Everything under public/ keeps a stable filename. Caching it for a year would
# keep serving replaced artwork out of the browser cache, so revalidate daily.
/textures/*
  Cache-Control: public, max-age=86400

/images/*
  Cache-Control: public, max-age=86400

/cursors/*
  Cache-Control: public, max-age=86400

/sounds/*
  Cache-Control: public, max-age=86400

/videos/*
  Cache-Control: public, max-age=86400
